<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Bit-Pop Android"
            android:textSize="24sp"
            android:textStyle="bold"
            android:gravity="center"
            android:layout_marginBottom="16dp" />

        <Spinner
            android:id="@+id/modeSpinner"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Index 1 (.bitpop)"
            android:textSize="14sp"
            android:textStyle="bold"
            android:layout_marginBottom="4dp" />

        <Button
            android:id="@+id/selectIndex1Button"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Choose Index 1"
            android:layout_marginBottom="4dp" />

        <TextView
            android:id="@+id/index1PathText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="(not selected)"
            android:textSize="11sp"
            android:textColor="#666666"
            android:layout_marginBottom="12dp" />

        <LinearLayout
            android:id="@+id/multiIndexLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Index 2 (.bitpop)"
                android:textSize="14sp"
                android:textStyle="bold"
                android:layout_marginBottom="4dp" />

            <Button
                android:id="@+id/selectIndex2Button"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Choose Index 2"
                android:layout_marginBottom="4dp" />

            <TextView
                android:id="@+id/index2PathText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="(not selected)"
                android:textSize="11sp"
                android:textColor="#666666"
                android:layout_marginBottom="12dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Index 3 (.bitpop) - optional"
                android:textSize="14sp"
                android:textStyle="bold"
                android:layout_marginBottom="4dp" />

            <Button
                android:id="@+id/selectIndex3Button"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Choose Index 3"
                android:layout_marginBottom="4dp" />

            <TextView
                android:id="@+id/index3PathText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="(not selected)"
                android:textSize="11sp"
                android:textColor="#666666"
                android:layout_marginBottom="12dp" />
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Reads File (.fastq)"
            android:textSize="14sp"
            android:textStyle="bold"
            android:layout_marginBottom="4dp" />

        <Button
            android:id="@+id/selectReadsButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Choose Reads"
            android:layout_marginBottom="4dp" />

        <TextView
            android:id="@+id/readsPathText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="(not selected)"
            android:textSize="11sp"
            android:textColor="#666666"
            android:layout_marginBottom="16dp" />

        <LinearLayout
            android:id="@+id/chunkingLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Chunking %"
                android:textSize="14sp"
                android:textStyle="bold"
                android:layout_marginBottom="4dp" />

            <EditText
                android:id="@+id/chunkPctEdit"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="numberDecimal"
                android:hint="3 (0 = no chunking)"
                android:text="3"
                android:layout_marginBottom="12dp" />
        </LinearLayout>

        <Button
            android:id="@+id/runButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Run"
            android:layout_marginBottom="12dp" />

        <ProgressBar
            android:id="@+id/progressBar"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:visibility="gone"
            android:layout_marginBottom="12dp" />

        <TextView
            android:id="@+id/statusText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text=""
            android:textSize="12sp"
            android:padding="8dp"
            android:minHeight="80dp" />

    </LinearLayout>
</ScrollView>
